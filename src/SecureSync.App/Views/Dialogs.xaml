<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared look for the app's dialog windows -->
    <Style x:Key="DialogWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
    </Style>

    <Style x:Key="DialogFooter" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ChromeBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>

    <Style x:Key="DialogHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="#003E92"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <HierarchicalDataTemplate x:Key="FolderNodeTemplate" ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal">
            <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="{Binding Name}" Margin="6,0,2,0" VerticalAlignment="Center"/>
        </StackPanel>
    </HierarchicalDataTemplate>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,14,0,6"/>
    </Style>
</ResourceDictionary>
