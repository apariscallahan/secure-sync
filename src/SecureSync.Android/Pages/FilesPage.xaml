<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SecureSync.Mobile"
             x:Class="SecureSync.Mobile.FilesPage">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Search" IconImageSource="ic_search.png" Order="Primary" Clicked="OnToggleSearch" />
        <ToolbarItem Text="Sync activity" Order="Secondary" Clicked="OnSyncActivity" />
        <ToolbarItem Text="Show sync chain key" Order="Secondary" Clicked="OnShowKey" />
        <ToolbarItem Text="Lock" Order="Secondary" Clicked="OnLock" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Sync status strip (tap for details) -->
        <Border x:Name="SyncStrip" BackgroundColor="{StaticResource Background}" StrokeThickness="0" Padding="16,10">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSyncActivity" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image x:Name="SyncIcon" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                    <Label x:Name="SyncLabel" Grid.Column="1" FontSize="14" TextColor="{StaticResource MutedColor}" VerticalOptions="Center"
                           LineBreakMode="TailTruncation" />
                </Grid>
                <ProgressBar x:Name="SyncProgress" IsVisible="False" />
            </VerticalStackLayout>
        </Border>

        <SearchBar x:Name="Search" Grid.Row="1" Placeholder="Search all files" IsVisible="False" TextChanged="OnSearchChanged" />

        <RefreshView x:Name="Refresher" Grid.Row="2" Refreshing="OnPullToRefresh" RefreshColor="{StaticResource Brand}">
            <CollectionView x:Name="List" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="32,64" Spacing="8">
                        <Image Source="type_folder.png" WidthRequest="56" HeightRequest="56" Opacity="0.5" />
                        <Label x:Name="EmptyLabel" HorizontalTextAlignment="Center" Style="{StaticResource Muted}"
                               Text="Nothing here yet. Tap + to upload files or make a folder." />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:ItemRow">
                        <Grid Padding="16,10,4,10" ColumnDefinitions="40,*,Auto,44" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped" />
                            </Grid.GestureRecognizers>
                            <Image Source="{Binding Icon}" WidthRequest="36" HeightRequest="36" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Name}" FontSize="16" LineBreakMode="MiddleTruncation" />
                                <Label Text="{Binding Detail}" FontSize="13" TextColor="{StaticResource MutedColor}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="{Binding StatusIcon}" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <ImageButton Grid.Column="3" Source="ic_more.png" WidthRequest="40" HeightRequest="40" Padding="10"
                                         BackgroundColor="Transparent" VerticalOptions="Center" Clicked="OnItemMenu" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Add button -->
        <Button x:Name="AddButton" Grid.Row="2" ImageSource="ic_add.png" WidthRequest="60" HeightRequest="60" CornerRadius="30"
                Padding="0" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,20,28" Clicked="OnAdd">
            <Button.Shadow>
                <Shadow Brush="Black" Opacity="0.25" Radius="10" Offset="0,4" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>
