<!--
  SecureSync per-user installer: no admin rights needed.
  Installs to %LOCALAPPDATA%\Programs\SecureSync, adds Desktop and Start menu shortcuts, and appears in
  Settings › Apps for uninstalling. Uninstalling removes the program only — never the encrypted folder or this
  computer's saved (Windows Hello–protected) key.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="SecureSync"
           Manufacturer="SecureSync"
           Version="$(var.ProductVersion)"
           UpgradeCode="846A1E93-5F8F-4919-A565-B416D24C810F"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of SecureSync is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="SecureSyncIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="SecureSyncIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="SecureSync" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Per-user components use an HKCU value as their key path, as Windows Installer requires for profile folders. -->
    <Component Id="App" Directory="INSTALLFOLDER" Guid="86F48A57-64CE-486C-8053-35688723ADF4">
      <File Id="SecureSyncExe" Source="$(var.AppExe)" Name="SecureSync.exe" />
      <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="SecureSync" Description="Encrypted file sync between your devices"
                Target="[#SecureSyncExe]" WorkingDirectory="INSTALLFOLDER" Icon="SecureSyncIcon" />
      <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="SecureSync" Description="Encrypted file sync between your devices"
                Target="[#SecureSyncExe]" WorkingDirectory="INSTALLFOLDER" Icon="SecureSyncIcon" />
      <RegistryValue Root="HKCU" Key="Software\SecureSync\Installer" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
    </Component>

    <Feature Id="Main" Title="SecureSync">
      <ComponentRef Id="App" />
    </Feature>
  </Package>
</Wix>
